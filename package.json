{
  "name": "abra-flexi-mcp",
  "version": "0.1.0",
  "description": "MCP server for the ABRA Flexi / FlexiBee REST API — generic CRUD over any evidence, with thorough tests.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "abra-flexi",
    "flexibee",
    "accounting",
    "rest-api"
  ],
  "bin": {
    "abra-flexi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
