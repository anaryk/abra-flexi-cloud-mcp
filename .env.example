# ABRA Flexi / FlexiBee connection (all required, no defaults)
# Base URL of the FlexiBee server, without the /c/{company} part.
FLEXIBEE_URL=https://demo.flexibee.eu
# Company (firma) identifier — the {company} segment in /c/{company}/...
FLEXIBEE_COMPANY=demo
# HTTP Basic auth credentials.
FLEXIBEE_USER=winstrom
FLEXIBEE_PASSWORD=winstrom

# Optional: set to "false" to disable TLS verification (NOT recommended).
# FLEXIBEE_REJECT_UNAUTHORIZED=true
